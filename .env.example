# Copy to .env and edit. Never commit .env.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Comma-separated. In production: your domain(s) and the Elastic IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production example: https://yourdomain.com,https://www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to True once HTTPS (certbot) is working. Makes cookies secure-only.
DJANGO_HTTPS=False

# Optional: use PostgreSQL instead of SQLite. Leave DB_NAME empty for SQLite.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
